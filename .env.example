# Copy to .env and uncomment what you want to change. Compose reads it if it is
# there and ignores it if it is not, so an empty deployment needs no .env at all.
#
# The binary itself never reads this file: it takes environment variables only,
# and every one of them already has a working default. What is shown after the
# `=` is that default — a commented line and the line uncommented as printed
# mean exactly the same thing.

# Where everything lives: index.db, the per-user storage roots, certificates.
# In the container this is the mounted volume and should stay as it is.
#DRIVE_DATA_DIR=/data

# What to listen on. Becomes :443 by itself once DRIVE_HOSTNAME is set.
#DRIVE_ADDR=:8080

# The public name, and the only switch for HTTPS there is. Set it and the drive
# obtains a real certificate by ACME and renews it; leave it unset and it serves
# plaintext, which is what you want behind a proxy that terminates TLS.
# Setting it means publishing 443 instead of 8080 — see DRIVE_PUBLISH below.
#DRIVE_HOSTNAME=drive.example.com
#DRIVE_ACME_EMAIL=you@example.com

# The CA to ask. The default is Let's Encrypt; a staging or private directory
# issues certificates no browser trusts, which is what makes it useful in a test.
#DRIVE_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory

# Headroom kept free on the data volume, in bytes. Uploads are refused before
# the disk fills, because a full disk fails writes partway.
#DRIVE_MIN_FREE_BYTES=1073741824

# Allowance a newly created account gets, in bytes. 0 is unlimited. It applies
# at account creation only; changing an existing account's quota is an
# administrator's decision, made per account.
#DRIVE_DEFAULT_QUOTA_BYTES=0

# How often every storage root is rescanned. This is the ceiling on how stale
# the index can be after a file arrives over SSH or rsync rather than the API.
#DRIVE_SCAN_INTERVAL=15m

# How long an interrupted upload waits to be resumed before its temporary data
# is reclaimed.
#DRIVE_UPLOAD_RETENTION=24h

# How long a deleted file stays in the trash before it is permanently deleted.
# 0 means never: nothing leaves the trash unless someone empties it.
#DRIVE_TRASH_RETENTION=720h

# compose.yml only, not read by the binary: the host:container port it publishes.
# Set it to 443:443 alongside DRIVE_HOSTNAME.
#DRIVE_PUBLISH=8080:8080
